rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 12
        && request.resource.data.photoURL is string;
      allow delete: if false;
    }
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'games', 'wins', 'kills', 'bestPlace', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 12
        && request.resource.data.games is int
        && request.resource.data.games >= 0
        && request.resource.data.wins is int
        && request.resource.data.wins >= 0
        && request.resource.data.wins <= request.resource.data.games
        && request.resource.data.kills is int
        && request.resource.data.kills >= 0
        && request.resource.data.bestPlace is int
        && request.resource.data.bestPlace >= 0
        && request.resource.data.bestPlace <= 40;
      allow delete: if false;
    }
  }
}
